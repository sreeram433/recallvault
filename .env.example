# Copy to .env.local (frontend) or backend/.env. Never commit real values.

# --- Next.js / Firebase App Hosting ---
NEXT_PUBLIC_APP_NAME=RecallVault
NEXT_PUBLIC_API_URL=
XAI_API_KEY=
XAI_MODEL=grok-4.6

# --- FastAPI / Cloud Run ---
APP_ENV=development
GCP_PROJECT_ID=dulcet-doodad-506019-v3
CORS_ALLOW_ORIGINS=http://localhost:3000
JWT_SECRET=
JWT_SECRET_RESOURCE=projects/dulcet-doodad-506019-v3/secrets/JWT_SECRET/versions/latest
DB_PASSWORD=
DB_PASSWORD_RESOURCE=projects/dulcet-doodad-506019-v3/secrets/DB_PASSWORD/versions/latest
DATABASE_URL=
INSTANCE_CONNECTION_NAME=dulcet-doodad-506019-v3:us-central1:recallvault-pg
DB_USER=recallvault
DB_NAME=recallvault
DB_IP_TYPE=private

# --- Cloud Storage ---
GCS_SCREENSHOTS_BUCKET=dulcet-doodad-506019-v3-recallvault-screenshots

# --- Optional local Cloud SQL proxy ---
# cloud-sql-proxy PROJECT:REGION:INSTANCE --port 5432
